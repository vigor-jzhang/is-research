# Environment variables for research-harness
# Copy to .env and set real values. Never commit .env.

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: override OpenRouter base URL
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Literature providers
# Crossref polite pool — your email for higher rate limits
CROSSREF_MAILTO=

# Semantic Scholar — optional API key for higher quotas
SEMANTIC_SCHOLAR_API_KEY=

# Unpaywall — required for OA lookup (https://unpaywall.org/products/api)
UNPAYWALL_EMAIL=

# Optional: DOI for live document smoke test
# FULLTEXT_SMOKE_DOI=10.1038/nature12373
